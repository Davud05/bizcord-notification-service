{
  "mappings": [
    {
      "name": "GET /api/channels/{id}/members - two demo members so @everyone has someone to reach",
      "request": {
        "method": "GET",
        "urlPathPattern": "/api/channels/[0-9a-fA-F-]{36}/members"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "channelId": "{{request.pathSegments.[2]}}",
          "memberIds": [
            "11111111-1111-1111-1111-111111111111",
            "22222222-2222-2222-2222-222222222222"
          ]
        },
        "transformers": ["response-template"]
      }
    }
  ]
}
