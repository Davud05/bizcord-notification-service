{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "EasyNetQ": "Warning",
      "Polly": "Warning"
    }
  },
  "AllowedHosts": "*",
  "EnableSwagger": true,

  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "SubscriptionId": "notification-service",
    "TimeoutSeconds": 10,
    "PrefetchCount": 10
  },

  "Services": {
    "UserDirectory": {
      "BaseUrl": "http://localhost:5080",
      "Enabled": true
    },
    "ChannelDirectory": {
      "BaseUrl": "http://localhost:5081",
      "Enabled": true
    }
  }
}
